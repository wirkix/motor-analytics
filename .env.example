# --- Ingest ---
# Where the raw Kaggle CSV lands. Download it yourself (Kaggle auth is
# per-account, this repo can't do it for you):
#   kaggle datasets download -d austinreese/craigslist-carstrucks-data \
#     -p data/raw --unzip
RAW_CSV_PATH=data/raw/vehicles.csv

# How many rows ingest/run.py samples down to, stratified by manufacturer so
# rare brands survive. ~426k raw rows -> 50k keeps the committed .duckdb file
# in the low tens-of-MB range and keeps the Streamlit chat agent's queries
# fast, while still giving it real aggregate variety to answer questions on.
SAMPLE_SIZE=50000

# --- Warehouse ---
# Single embedded DuckDB file — no server, no Docker. Committed to git once
# built (see README "Why a committed .duckdb"): it's what lets the Streamlit
# app run with zero setup beyond ANTHROPIC_API_KEY.
DUCKDB_PATH=data/motor_analytics.duckdb

# --- Banxico (FX + inflation enrichment) ---
# Free token: https://www.banxico.org.mx/SieAPIRest/service/v1/token
# Leave blank to run the pipeline anyway — enrich/run.py falls back to a
# flagged constant (fx_rate=17.5, inpc ratio=1.0, is_fallback=true) instead
# of failing, so the whole thing stays buildable/demoable without this.
BANXICO_TOKEN=

# --- Streamlit chat agent (Claude API) ---
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5 if left blank (app/claude_agent.py). Swap to
# claude-sonnet-5 or claude-haiku-4-5 for a cheaper/faster demo.
ANTHROPIC_MODEL=
